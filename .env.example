# The app loads this file only as an example. Put real values in .env.local.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Optional provider overrides. The defaults match the fixed UI profiles.
OPENAI_MODEL=gpt-5.6-sol
ANTHROPIC_MODEL=claude-opus-5
XAI_MODEL=grok-4.6

# Raw CoreGraphics mouse button number: 3 is usually the first side button.
INTELLIGENT_CURSOR_MOUSE_BUTTON=3

